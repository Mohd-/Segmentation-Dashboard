# Live application data — never version the database.
# To back up: stop the app and copy pipeline_tracker.db (plus -wal/-shm if present).
# Pre-deployment: the DB is throwaway (see migrations.py); on a schema change,
# just delete these files and restart the app to regenerate a fresh one.
*.db
*.db-shm
*.db-wal

# Local environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Approved model binary is deployed out-of-band, not versioned.
RF_model.joblib
portfolio-analysis.png
